---
import { slugify } from '../utils/slug';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

const posts = await getCollection('blog');
const topics = [...new Set(posts.map((post) => post.data.topic).filter(Boolean))].sort();
---

<header>
	<nav>
		<h2 class="brand">
			<a href="/" aria-label={`${SITE_TITLE} home`}>
				<span class="brand-mark" aria-hidden="true">🧸</span>
				<span class="brand-name">{SITE_TITLE}</span>
			</a>
		</h2>
		<div class="internal-links" id="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<div class="dropdown">
				<button
					id="categories-trigger"
					class="dropdown-trigger"
					type="button"
					aria-haspopup="true"
					aria-expanded="false"
				>
					Topics <span class="caret" aria-hidden="true">▾</span>
				</button>
				<ul id="categories-menu" class="dropdown-menu">
					{
						topics.map((topic) => (
							<li>
								<a href={`/topic/${slugify(topic)}/`}>
									{topic}
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>
		<div class="header-actions">
			<button id="theme-toggle" aria-label="Toggle dark mode" type="button">
				<span id="theme-icon">🌙</span>
			</button>
			<button id="mobile-menu-toggle" class="mobile-menu-toggle" aria-label="Toggle menu" aria-expanded="false" type="button">
				<span></span><span></span><span></span>
			</button>
		</div>
	</nav>
</header>
<script>
	const themeButton = document.getElementById('theme-toggle');
	const themeIcon = document.getElementById('theme-icon');

	function syncIcon() {
		const current = document.documentElement.getAttribute('data-theme');
		if (themeIcon) themeIcon.textContent = current === 'dark' ? '☀️' : '🌙';
	}
	syncIcon();

	themeButton?.addEventListener('click', () => {
		const current = document.documentElement.getAttribute('data-theme');
		const next = current === 'dark' ? 'light' : 'dark';
		document.documentElement.setAttribute('data-theme', next);
		localStorage.setItem('theme', next);
		syncIcon();
	});

	const catTrigger = document.getElementById('categories-trigger');
	const catMenu = document.getElementById('categories-menu');

	catTrigger?.addEventListener('click', (e) => {
		e.stopPropagation();
		const isOpen = catMenu?.classList.toggle('open');
		catTrigger.setAttribute('aria-expanded', String(!!isOpen));
	});

	document.addEventListener('click', () => {
		catMenu?.classList.remove('open');
		catTrigger?.setAttribute('aria-expanded', 'false');
	});

	const mobileToggle = document.getElementById('mobile-menu-toggle');
	const internalLinks = document.getElementById('internal-links');

	mobileToggle?.addEventListener('click', (e) => {
		e.stopPropagation();
		const isOpen = internalLinks?.classList.toggle('mobile-open');
		mobileToggle.setAttribute('aria-expanded', String(!!isOpen));
		mobileToggle.classList.toggle('active', !!isOpen);
	});

	internalLinks?.addEventListener('click', (e) => {
		const target = e.target;
		if (target instanceof HTMLElement && target.tagName === 'A') {
			internalLinks.classList.remove('mobile-open');
			mobileToggle?.setAttribute('aria-expanded', 'false');
			mobileToggle?.classList.remove('active');
		}
	});

	document.addEventListener('click', (e) => {
		if (
			internalLinks?.classList.contains('mobile-open') &&
			!internalLinks.contains(e.target) &&
			e.target !== mobileToggle
		) {
			internalLinks.classList.remove('mobile-open');
			mobileToggle?.setAttribute('aria-expanded', 'false');
			mobileToggle?.classList.remove('active');
		}
	});
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		margin: 0;
		padding: 0 1em;
		background: var(--surface);
		border-bottom: 1px solid rgb(var(--border));
		box-shadow: 0 4px 18px rgba(var(--shadow), 6%);
	}
	/* rainbow strip, same palette as the home page hero */
	header::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		height: 4px;
		background: linear-gradient(
			90deg,
			#f45b9b 0 16.66%,
			#f97316 0 33.33%,
			#ffc233 0 50%,
			#22a559 0 66.66%,
			#0ea5e9 0 83.33%,
			#a855f7 0 100%
		);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1100px;
		margin: 0 auto;
		min-height: 66px;
	}
	.brand {
		margin: 0;
		font-size: 1em;
	}
	.brand a {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		color: rgb(var(--black));
	}
	.brand-mark {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: 12px;
		background: linear-gradient(135deg, #ffc233, #ff6b4a);
		font-size: 1.35rem;
		box-shadow: 0 3px 0 rgba(194, 65, 12, 0.35);
		transform: rotate(-6deg);
		transition: transform 0.25s ease;
	}
	.brand a:hover .brand-mark {
		transform: rotate(6deg) scale(1.06);
	}
	.brand-name {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.4rem;
		letter-spacing: -0.01em;
		line-height: 1;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		margin-left: auto;
		margin-right: 0.6rem;
	}
	.internal-links > :global(a),
	.dropdown-trigger {
		position: relative;
		padding: 0.5rem 0.95rem;
		border-radius: 999px;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		font-family: var(--font-text);
		font-weight: 700;
		font-size: 0.95rem;
		transition: background 0.2s ease, color 0.2s ease;
	}
	.internal-links > :global(a:hover),
	.dropdown-trigger:hover,
	.dropdown-trigger[aria-expanded='true'] {
		background: rgb(var(--gray-light));
		color: rgb(var(--black));
	}
	.internal-links > :global(a.active) {
		background: var(--accent-soft);
		color: var(--accent-text);
	}
	.dropdown {
		position: relative;
	}
	.dropdown-trigger {
		background: none;
		border: none;
		cursor: pointer;
	}
	.caret {
		display: inline-block;
		font-size: 0.75em;
		transition: transform 0.2s ease;
	}
	.dropdown-trigger[aria-expanded='true'] .caret {
		transform: rotate(180deg);
	}
	.dropdown-menu {
		position: absolute;
		top: calc(100% + 8px);
		right: 0;
		min-width: 250px;
		width: max-content;
		max-width: 92vw;
		margin: 0;
		padding: 0.5rem;
		list-style: none;
		background: var(--surface);
		border: 1px solid rgb(var(--border));
		border-radius: 16px;
		box-shadow: var(--box-shadow);
		opacity: 0;
		visibility: hidden;
		transform: translateY(-6px);
		transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
		z-index: 60;
	}
	.dropdown-menu.open {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}
	.dropdown-menu li {
		margin: 0;
	}
	.dropdown-menu a {
		display: block;
		padding: 0.55rem 0.85rem;
		border-radius: 10px;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		font-weight: 700;
		font-size: 0.93rem;
		line-height: 1.35;
	}
	.dropdown-menu a:hover {
		background: var(--accent-soft);
		color: var(--accent-text);
	}
	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.2rem;
	}
	#theme-toggle {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		background: rgb(var(--gray-light));
		border: none;
		border-radius: 50%;
		cursor: pointer;
		font-size: 1.1rem;
		line-height: 1;
		transition: transform 0.2s ease;
	}
	#theme-toggle:hover {
		transform: rotate(18deg) scale(1.08);
	}
	.mobile-menu-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 4px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.6em;
		margin-left: 0.3em;
	}
	.mobile-menu-toggle span {
		display: block;
		width: 22px;
		height: 2px;
		border-radius: 2px;
		background: rgb(var(--black));
		transition: transform 0.2s ease, opacity 0.2s ease;
	}
	.mobile-menu-toggle.active span:nth-child(1) {
		transform: translateY(6px) rotate(45deg);
	}
	.mobile-menu-toggle.active span:nth-child(2) {
		opacity: 0;
	}
	.mobile-menu-toggle.active span:nth-child(3) {
		transform: translateY(-6px) rotate(-45deg);
	}

	@media (max-width: 640px) {
		nav {
			flex-wrap: wrap;
			min-height: 60px;
		}
		.brand-name {
			font-size: 1.2rem;
		}
		.brand-mark {
			width: 36px;
			height: 36px;
		}
		.header-actions {
			margin-left: auto;
		}
		.mobile-menu-toggle {
			display: flex;
		}
		.internal-links {
			display: none;
			flex-direction: column;
			align-items: stretch;
			gap: 0.2rem;
			width: 100%;
			order: 3;
			margin: 0;
			padding: 0.3em 0 1em 0;
		}
		.internal-links.mobile-open {
			display: flex;
		}
		.internal-links > :global(a),
		.dropdown-trigger {
			padding: 0.75rem 0.9rem;
			border-radius: 12px;
		}
		.dropdown {
			width: 100%;
		}
		.dropdown-trigger {
			width: 100%;
			text-align: left;
		}
		.dropdown-menu {
			position: static;
			min-width: 0;
			width: auto;
			max-width: none;
			box-shadow: none;
			border: none;
			background: transparent;
			opacity: 1;
			visibility: visible;
			transform: none;
			display: none;
			padding: 0.2rem 0 0.2rem 0.8rem;
		}
		.dropdown-menu a {
			white-space: normal;
		}
		.dropdown-menu.open {
			display: block;
		}
	}
</style>
