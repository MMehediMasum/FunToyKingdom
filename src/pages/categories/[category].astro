---
import { slugify } from '../../utils/slug';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { FALLBACK_TOPIC_META, SITE_DESCRIPTION, SITE_TITLE, TOPIC_META } from '../../consts';

export async function getStaticPaths() {
	const allPosts = await getCollection('blog');
	const categories = [...new Set(allPosts.flatMap((post) => post.data.categories))];
	return categories.map((category) => ({
		params: { category: slugify(category) },
		props: { categoryName: category },
	}));
}

const { categoryName } = Astro.props;
const allPosts = await getCollection('blog');
const postsInCategory = allPosts
	.filter((post) => post.data.categories.includes(categoryName))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const [featuredPost, ...restPosts] = postsInCategory;

// The topic this category lives under (used for breadcrumb + colour)
const topicName = postsInCategory.find((post) => post.data.topic)?.data.topic;
const meta = (topicName && TOPIC_META[topicName]) || FALLBACK_TOPIC_META;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${categoryName} - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: min(1100px, 100% - 2em);
				max-width: 100%;
				padding: 1.8rem 0 3.5rem;
			}

			/* ---------- page header ---------- */
			.category-header {
				margin-bottom: 2.2rem;
				padding: 1.8rem 2rem;
				border-radius: 24px;
				background: var(--surface);
				border: 1px solid rgb(var(--border));
				border-left: 8px solid var(--to);
				box-shadow: 0 2px 10px rgba(var(--shadow), 6%);
			}
			.crumbs {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin-bottom: 0.7rem;
				font-size: 0.85rem;
				font-weight: 700;
				color: rgb(var(--gray));
			}
			.crumbs a {
				color: rgb(var(--gray));
				text-decoration: none;
			}
			.crumbs a:hover {
				color: var(--accent-text);
			}
			.crumbs .sep {
				opacity: 0.5;
			}
			.category-title {
				margin: 0 0 0.4rem;
				font-size: clamp(1.8rem, 4.2vw, 2.6rem);
				line-height: 1.15;
				text-wrap: balance;
			}
			.category-meta {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.95rem;
				font-weight: 700;
			}

			/* ---------- shared card bits ---------- */
			.post-list {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.6rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			.post-list li {
				margin: 0;
			}
			.thumb {
				position: relative;
				overflow: hidden;
				background: linear-gradient(135deg, var(--from), var(--to));
			}
			.thumb .fallback {
				position: absolute;
				inset: 0;
				display: grid;
				place-items: center;
				font-size: 3rem;
				opacity: 0.85;
			}
			.thumb img {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				border-radius: 0;
				transition: transform 0.4s ease;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.85rem;
				font-weight: 700;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1.25;
				transition: color 0.2s ease;
			}

			/* ---------- featured (latest) post ---------- */
			.featured {
				display: grid;
				grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
				margin-bottom: 2rem;
				border-radius: 26px;
				overflow: hidden;
				text-decoration: none;
				color: rgb(var(--black));
				background: var(--surface);
				border: 1px solid rgb(var(--border));
				box-shadow: 0 2px 10px rgba(var(--shadow), 6%);
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}
			.featured:hover {
				transform: translateY(-3px);
				box-shadow: var(--box-shadow);
			}
			.featured .thumb {
				min-height: 300px;
			}
			.featured .thumb .fallback {
				font-size: 5rem;
			}
			.featured:hover .thumb img {
				transform: scale(1.05);
			}
			.featured-body {
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: flex-start;
				gap: 0.8rem;
				padding: 2rem 2.2rem;
			}
			.badge {
				padding: 0.25rem 0.85rem;
				border-radius: 999px;
				background: #ffc233;
				color: #14171f;
				font-size: 0.78rem;
				font-weight: 700;
				letter-spacing: 0.05em;
			}
			.featured .title {
				font-size: clamp(1.5rem, 2.8vw, 2.1rem);
			}
			.featured:hover .title {
				color: var(--accent-text);
			}
			.read-more {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				margin-top: 0.3rem;
				padding: 0.55rem 1.2rem;
				border-radius: 999px;
				background: var(--accent-strong);
				color: #fff;
				font-size: 0.9rem;
				font-weight: 700;
				box-shadow: 0 3px 0 rgba(0, 0, 0, 0.2);
			}

			/* ---------- regular post cards ---------- */
			.post-card {
				display: flex;
				flex-direction: column;
				height: 100%;
				border-radius: 20px;
				overflow: hidden;
				text-decoration: none;
				background: var(--surface);
				border: 1px solid rgb(var(--border));
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}
			.post-card:hover {
				transform: translateY(-4px);
				box-shadow: var(--box-shadow);
			}
			.post-card .thumb {
				aspect-ratio: 16 / 10;
			}
			.post-card:hover .thumb img {
				transform: scale(1.06);
			}
			.card-body {
				display: flex;
				flex-direction: column;
				flex-grow: 1;
				gap: 0.45rem;
				padding: 1rem 1.2rem 1.2rem;
			}
			.post-card .title {
				font-size: 1.1rem;
			}
			.post-card:hover .title {
				color: var(--accent-text);
			}
			.post-card .date {
				margin-top: auto;
				padding-top: 0.3rem;
			}

			.empty {
				text-align: center;
				color: rgb(var(--gray));
			}

			@media (max-width: 960px) {
				.post-list {
					grid-template-columns: repeat(2, 1fr);
				}
			}
			@media (max-width: 760px) {
				.featured {
					grid-template-columns: 1fr;
				}
				.featured .thumb {
					min-height: 0;
					aspect-ratio: 16 / 10;
				}
				.featured-body {
					padding: 1.4rem 1.4rem 1.6rem;
				}
				.category-header {
					padding: 1.4rem 1.3rem;
				}
			}
			@media (max-width: 560px) {
				.post-list {
					grid-template-columns: 1fr;
					gap: 1.2rem;
				}
			}
			@media (prefers-reduced-motion: reduce) {
				.featured,
				.post-card,
				.thumb img {
					transition: none;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main style={`--from:${meta.from};--to:${meta.to};`}>
			<header class="category-header">
				<nav class="crumbs" aria-label="Breadcrumb">
					<a href="/">Home</a>
					{
						topicName && (
							<>
								<span class="sep">›</span>
								<a href={`/topic/${slugify(topicName)}/`}>{topicName}</a>
							</>
						)
					}
				</nav>
				<h1 class="category-title">{categoryName}</h1>
				<p class="category-meta">
					{postsInCategory.length}
					{postsInCategory.length === 1 ? 'guide' : 'guides'}
				</p>
			</header>

			<section>
				{
					postsInCategory.length === 0 ? (
						<p class="empty">No posts found in this category yet.</p>
					) : (
						<>
							<a class="featured" href={`/${featuredPost.id}/`}>
								<div class="thumb">
									<span class="fallback" aria-hidden="true">
										{meta.icon}
									</span>
									{featuredPost.data.heroImage && (
										<img src={featuredPost.data.heroImage} alt="" loading="lazy" onerror="this.style.display='none'" />
									)}
								</div>
								<div class="featured-body">
									<span class="badge">⭐ LATEST</span>
									<h2 class="title">{featuredPost.data.title}</h2>
									<p class="date">
										<FormattedDate date={featuredPost.data.pubDate} />
									</p>
									<span class="read-more">
										Read the guide <span aria-hidden="true">→</span>
									</span>
								</div>
							</a>

							{restPosts.length > 0 && (
								<ul class="post-list">
									{restPosts.map((post) => (
										<li>
											<a class="post-card" href={`/${post.id}/`}>
												<div class="thumb">
													<span class="fallback" aria-hidden="true">
														{meta.icon}
													</span>
													{post.data.heroImage && (
														<img src={post.data.heroImage} alt="" loading="lazy" onerror="this.style.display='none'" />
													)}
												</div>
												<div class="card-body">
													<h3 class="title">{post.data.title}</h3>
													<p class="date">
														<FormattedDate date={post.data.pubDate} />
													</p>
												</div>
											</a>
										</li>
									))}
								</ul>
							)}
						</>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
