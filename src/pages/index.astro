---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const topics = [...new Set(allPosts.map((post) => post.data.topic).filter(Boolean))].sort();
const topicCategorySets = new Map();
for (const post of allPosts) {
	if (!post.data.topic) continue;
	if (!topicCategorySets.has(post.data.topic)) {
		topicCategorySets.set(post.data.topic, new Set());
	}
	for (const category of post.data.categories ?? []) {
		topicCategorySets.get(post.data.topic).add(category);
	}
}
const topicCounts = new Map(
	[...topicCategorySets.entries()].map(([topic, set]) => [topic, set.size])
);

const [featuredTopic, ...otherTopics] = topics;

const [featuredPost, ...restPosts] = allPosts.slice(0, 7);

function thumbUrl(query: string) {
	const q = encodeURIComponent(query);
	return `https://tse1.mm.bing.net/th?q=${q}&w=474&h=274&c=7`;
}

function formatDate(date: Date) {
	return new Intl.DateTimeFormat('en-US', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	}).format(date);
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: min(1100px, 92vw);
				margin: 0 auto;
			}

			/* ---------- Hero ---------- */
			.hero {
				position: relative;
				overflow: hidden;
				background:
					radial-gradient(ellipse 58% 80% at 10% 12%, rgba(255, 107, 107, 0.20), transparent 60%),
					radial-gradient(ellipse 55% 75% at 90% 8%, rgba(255, 190, 70, 0.24), transparent 60%),
					radial-gradient(ellipse 65% 60% at 50% 118%, rgba(70, 184, 209, 0.18), transparent 65%),
					linear-gradient(180deg, #fffaf0 0%, #fff1dc 100%);
				border-radius: 24px;
				padding: 4.5rem 2.5rem;
				margin: 1.5rem auto 3.5rem;
				text-align: center;
			}
			.hero::before {
				content: '';
				position: absolute;
				top: 0;
				right: 0;
				bottom: 0;
				left: 0;
				z-index: 0;
				background-image: url("data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%27120%27 height=%27120%27%3E%3Cg fill=%27%23e0585e%27%3E%3Ccircle cx=%2720%27 cy=%2725%27 r=%276%27/%3E%3Ccircle cx=%2792%27 cy=%2718%27 r=%274%27/%3E%3Cpath d=%27M62 48l4.5 9.3 10.2 1.5-7.4 7.2 1.7 10.2L62 71l-9 5.2 1.7-10.2-7.4-7.2 10.2-1.5z%27/%3E%3Ccircle cx=%2718%27 cy=%2795%27 r=%274%27/%3E%3Ccircle cx=%2798%27 cy=%2790%27 r=%276%27/%3E%3Crect x=%2745%27 y=%27100%27 width=%2710%27 height=%2710%27 rx=%272%27/%3E%3C/g%3E%3C/svg%3E");
				background-size: 120px 120px;
				opacity: 0.07;
				pointer-events: none;
			}
			.hero-content {
				position: relative;
				z-index: 1;
				/* Hero background is always a light cream gradient, in both
				   light and dark site themes, so its text must stay fixed
				   dark colors rather than following the --black/--gray-dark
				   theme variables (which flip to light colors in dark mode
				   and would become invisible here). */
				color: #14171f;
			}
			.hero h1 {
				font-size: clamp(2rem, 4vw, 2.9rem);
				line-height: 1.15;
				margin: 0 0 0.6em;
				max-width: 22ch;
				margin-left: auto;
				margin-right: auto;
				color: #14171f;
			}
			.hero p {
				max-width: 52ch;
				margin: 0 auto;
				color: #4a5164;
				font-size: 1.1rem;
			}

			/* ---------- Topic cards ---------- */
			.section-heading {
				font-size: 1.5rem;
				margin: 0 0 1.2rem;
			}
			.topic-row {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
				gap: 1.5rem;
				list-style: none;
				margin: 0 0 3.5rem;
				padding: 0;
			}
			.topic-card {
				position: relative;
				display: block;
				border-radius: 16px;
				overflow: hidden;
				aspect-ratio: 4 / 3;
				text-decoration: none;
				color: white;
				box-shadow: 0 1px 3px rgba(var(--gray), 25%);
				transition: transform 0.2s ease;
			}
			.topic-card:hover {
				transform: translateY(-3px);
			}
			.topic-card img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}
			.topic-card .overlay {
				position: absolute;
				inset: 0;
				background: linear-gradient(180deg, rgba(15, 18, 25, 0) 40%, rgba(15, 18, 25, 0.75) 100%);
			}
			.topic-card .label {
				position: absolute;
				left: 1.2rem;
				bottom: 1rem;
				right: 1.2rem;
			}
			.topic-card .label h3 {
				margin: 0;
				font-size: 1.4rem;
				color: #fff;
			}
			.topic-card .label span {
				font-size: 0.85rem;
				opacity: 0.85;
				color: #fff;
			}

			/* ---------- Featured topic banner ---------- */
			.topic-featured {
				position: relative;
				display: block;
				border-radius: 20px;
				overflow: hidden;
				aspect-ratio: 21 / 6;
				text-decoration: none;
				color: white;
				box-shadow: 0 1px 3px rgba(var(--gray), 25%);
				margin-bottom: 1.4rem;
			}
			.topic-featured img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}
			.topic-featured .overlay {
				position: absolute;
				top: 0;
				right: 0;
				bottom: 0;
				left: 0;
				background: linear-gradient(100deg, rgba(15, 18, 25, 0.78) 0%, rgba(15, 18, 25, 0.5) 42%, rgba(15, 18, 25, 0.05) 78%);
			}
			.topic-featured .label {
				position: absolute;
				left: 2.2rem;
				top: 50%;
				transform: translateY(-50%);
				max-width: 60%;
			}
			.topic-featured .label h3 {
				margin: 0 0 0.3rem;
				font-size: clamp(1.4rem, 3vw, 2.1rem);
				color: #fff;
			}
			.topic-featured .label span {
				font-size: 0.95rem;
				opacity: 0.92;
				color: #fff;
			}
			@media (max-width: 640px) {
				.topic-featured {
					aspect-ratio: 4 / 3;
				}
				.topic-featured .label {
					max-width: 80%;
				}
			}

			/* ---------- Latest posts ---------- */
			.post-category {
				font-size: 0.8rem;
				color: var(--accent-dark);
				font-weight: 600;
				margin-bottom: 0.25rem;
			}
			.post-title {
				line-height: 1.35;
				font-weight: 700;
				margin: 0 0 0.4rem;
			}
			.post-date {
				font-size: 0.82rem;
				color: rgb(var(--gray));
			}

			/* Featured post (big, editorial) */
			.post-featured {
				display: grid;
				grid-template-columns: 1.15fr 1fr;
				gap: 2.2rem;
				align-items: center;
				text-decoration: none;
				color: rgb(var(--black));
				margin-bottom: 2.6rem;
			}
			.post-featured .post-thumb {
				aspect-ratio: 4 / 3;
				border-radius: 16px;
				overflow: hidden;
				background: rgb(var(--gray-light));
			}
			.post-featured .post-thumb img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				transition: transform 0.3s ease;
			}
			.post-featured:hover .post-thumb img {
				transform: scale(1.04);
			}
			.post-featured .post-title {
				font-size: clamp(1.3rem, 2.4vw, 1.7rem);
			}
			.post-featured:hover .post-title {
				color: var(--accent);
			}
			.post-featured .post-excerpt {
				color: rgb(var(--gray-dark));
				font-size: 0.98rem;
				line-height: 1.65;
				margin: 0.7rem 0 0.9rem;
			}

			/* Remaining posts: compact two-column list rows */
			.post-list {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.4rem 2.2rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.post-row {
				display: flex;
				gap: 1rem;
				align-items: center;
				text-decoration: none;
				color: rgb(var(--black));
			}
			.post-row .post-thumb {
				flex: none;
				width: 88px;
				height: 88px;
				border-radius: 10px;
				overflow: hidden;
				background: rgb(var(--gray-light));
			}
			.post-row .post-thumb img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}
			.post-row .post-title {
				font-size: 0.98rem;
				margin: 0 0 0.3rem;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.post-row:hover .post-title {
				color: var(--accent);
			}

			@media (max-width: 720px) {
				.post-featured {
					grid-template-columns: 1fr;
				}
				.post-list {
					grid-template-columns: 1fr;
				}
			}

			@media (max-width: 640px) {
				.hero {
					padding: 2.2rem 1.4rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-content">
					<h1>Find Every Kid's Next Favorite Toy</h1>
					<p>{SITE_DESCRIPTION}</p>
				</div>
			</section>

			<section>
				<h2 class="section-heading">Browse by Toy Types</h2>

				{featuredTopic && (
					<a
						class="topic-featured"
						href={`/topic/${featuredTopic.toLowerCase().replace(/\s+/g, '-')}/`}
					>
						<img src={thumbUrl(featuredTopic)} alt="" loading="lazy" onerror="this.style.display='none'" />
						<div class="overlay" />
						<div class="label">
							<h3>{featuredTopic}</h3>
							<span>{topicCounts.get(featuredTopic)} categories</span>
						</div>
					</a>
				)}

				<ul class="topic-row">
					{
						otherTopics.map((topic) => (
							<li>
								<a class="topic-card" href={`/topic/${topic.toLowerCase().replace(/\s+/g, '-')}/`}>
									<img src={thumbUrl(topic)} alt="" loading="lazy" onerror="this.style.display='none'" />
									<div class="overlay" />
									<div class="label">
										<h3>{topic}</h3>
										<span>{topicCounts.get(topic)} categories</span>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>

			<section>
				<h2 class="section-heading">Latest articles</h2>

				{featuredPost && (
					<a class="post-featured" href={`/${featuredPost.id}/`}>
						<div class="post-thumb">
							<img
								src={thumbUrl(`${featuredPost.data.topic ?? ''} ${featuredPost.data.title}`)}
								alt=""
								loading="lazy"
								onerror="this.style.display='none'"
							/>
						</div>
						<div>
							{featuredPost.data.categories?.[0] && (
								<span class="post-category">{featuredPost.data.categories[0]}</span>
							)}
							<h3 class="post-title">{featuredPost.data.title}</h3>
							<p class="post-excerpt">{featuredPost.data.description}</p>
							<span class="post-date">{formatDate(featuredPost.data.pubDate)}</span>
						</div>
					</a>
				)}

				<ul class="post-list">
					{
						restPosts.map((post) => (
							<li>
								<a class="post-row" href={`/${post.id}/`}>
									<div class="post-thumb">
										<img
											src={thumbUrl(`${post.data.topic ?? ''} ${post.data.title}`)}
											alt=""
											loading="lazy"
											onerror="this.style.display='none'"
										/>
									</div>
									<div>
										{post.data.categories?.[0] && (
											<span class="post-category">{post.data.categories[0]}</span>
										)}
										<h3 class="post-title">{post.data.title}</h3>
										<span class="post-date">{formatDate(post.data.pubDate)}</span>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
